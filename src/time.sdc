# ============================================================
# 1. 创建主时钟 (Primary Clock)
# 根据你板子上的实际晶振频率修改 period (单位: ns)
# 例如: 50MHz -> 20.000;  100MHz -> 10.000;  73.2MHz -> 13.661
# ============================================================
create_clock -name clk -period 20.000 [get_ports {clk}]

# ============================================================
# 2. (可选) 如果有衍生时钟，用此命令定义
# 如果你的PLL输出频率是 100MHz，且命名为 pll_out_clk
# ============================================================
# create_clock -name pll_clk -period 10.000 [get_ports {clk_pll_out}]

# ============================================================
# 3. (可选) 异步复位信号处理 (解决你的 Recovery 违例)
# 告诉时序工具：复位信号不需要检查建立/恢复时间，放宽要求。
# ============================================================
# set_false_path -from [get_ports {rst_debounced}] -to [all_registers]

# ============================================================
# 4. 输入延迟约束 (如果外部有数据输入给 FPGA)
# input_delay -max 4.000 -clock clk [get_ports {data_in*}]
# input_delay -min 1.000 -clock clk [get_ports {data_in*}]

# ============================================================
# 5. 输出延迟约束 (如果 FPGA 输出数据给外部芯片)
# output_delay -max 5.000 -clock clk [get_ports {data_out*}]
# output_delay -min 1.000 -clock clk [get_ports {data_out*}]

# ============================================================
# 6. 时序例外 (如果某些路径确实不需要那么快)
# 如果某个跨时钟域的信号有专用异步 FIFO 处理，可以设为假路径
# ============================================================
# set_clock_groups -asynchronous -group {clk} -group {pll_clk}